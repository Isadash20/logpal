# Supabase credentials for cloud sync.
#
# Copy to .env.local for development, and set the same two variables in the
# Vercel project settings for production.
#
# Both are safe to expose in a browser bundle: the anon key only grants what
# row level security allows, and every LogPal table is restricted to
# `auth.uid() = user_id`. Never put the service_role key here.
#
# Vite inlines these at BUILD time, so changing them in Vercel does nothing
# until the next deployment.
#
# Leaving them unset is supported: LogPal then runs exactly as it did before
# sync existed — signed out, on this device only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
